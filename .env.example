# ── Cliente (Vite; terminan en el bundle, son públicas) ─────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Opcional: captcha en el registro (Cloudflare Turnstile, gratis)
VITE_TURNSTILE_SITE_KEY=

# ── Netlify Function (solo servidor; NUNCA al cliente) ──────────────────────
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=

# ── Topes de gasto de IA (opcionales; estos son los valores por defecto) ────
AI_CALLS_PER_USER_DAY=15
AI_CALLS_PER_USER_MONTH=400
AI_MONTHLY_BUDGET_USD=40
